{
  "name": "cohorts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001 --turbo",
    "dev:turbo": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "stripe:webhook": "stripe listen --forward-to http://localhost:3001/api/webhooks/stripe",
    "db:migrate": "npx supabase migration up",
    "db:reset": "npx supabase db reset",
    "db:diff": "npx supabase db diff --schema public",
    "db:types": "npx supabase gen types typescript --local > src/lib/types/database.types.ts ",
    "zod:generate": "bunx supabase-to-zod --input src/lib/types/database.types.ts --output src/lib/types/zod-schemas.ts",
    "supabase:start": "npx supabase start",
    "db:mcp": "npx -y @modelcontextprotocol/server-postgres postgresql://postgres:postgres@127.0.0.1:54322/postgres",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
